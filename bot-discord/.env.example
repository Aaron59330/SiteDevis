# Identifiants depuis https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Générez une longue chaîne aléatoire (ex. openssl rand -hex 32)
SESSION_SECRET=change-me-with-a-long-random-secret

# Adresse d'écoute et URL publique du panneau
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
NODE_ENV=development
