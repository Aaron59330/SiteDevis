# Copiez ce fichier en ".env" puis adaptez-le. Tout est optionnel pour un essai en local.
PORT=3000
APP_URL=http://localhost:3000

# Compte administrateur créé au premier lancement
ADMIN_EMAIL=vous@exemple.fr
ADMIN_PASSWORD=ChoisissezUnMotDePasse1

# Envoi réel des emails (https://resend.com) — sans cela, les emails sont visibles dans l'admin (mode démo)
RESEND_API_KEY=
MAIL_FROM="Mes Devis <contact@votredomaine.fr>"

# Paiement réel par carte (https://stripe.com) — sans cela, un paiement de démonstration est proposé
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# En production : mettre false pour interdire les paiements de démonstration, et true derrière HTTPS
ALLOW_SIMULATED_PAYMENTS=true
COOKIE_SECURE=false
